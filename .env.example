# Copy to .env and load it (for example with `set -a; source .env; set +a`).
# Never commit the real .env file.

# LLM provider: none | anthropic | openai | ollama
SRE_AGENT_LLM_PROVIDER=none
# Model name (optional for anthropic and ollama, required for openai)
SRE_AGENT_LLM_MODEL=
# Request timeout in seconds
SRE_AGENT_LLM_TIMEOUT=120

# anthropic
ANTHROPIC_API_KEY=

# openai (any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ollama
OLLAMA_HOST=
